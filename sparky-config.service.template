[Unit]
Description=Sparky Configuration UI
Documentation=https://github.com/oorrwullie/sparky
After=network.target

[Service]
Type=simple
User={{SERVICE_USER}}
WorkingDirectory={{WORKING_DIRECTORY}}
EnvironmentFile=/etc/sparky/config-ui.env
ExecStart={{EXEC_START}} --config {{WORKING_DIRECTORY}}config.yml --listen 127.0.0.1:8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Restrict writes to Sparky's existing working directory, where the legacy
# gateway service already expects config.yml. Do not expose this port remotely.
ReadWritePaths={{WORKING_DIRECTORY}}
# Config YAML remains writable by the service account. The installer does not
# grant broader privileges or enable web-triggered restart.

[Install]
WantedBy=multi-user.target
